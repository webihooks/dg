<?php
// test_new_order.php - FIXED VERSION
error_reporting(E_ALL);
ini_set('display_errors', 0); // Don't display errors to avoid corrupting JSON
ini_set('log_errors', 1);

// Start output buffering to prevent any output before headers
ob_start();

header('Content-Type: application/json');
header('Cache-Control: no-cache, no-store, must-revalidate');
header('Pragma: no-cache');
header('Expires: 0');

session_start();

if (!isset($_SESSION['user_id'])) {
    echo json_encode(['success' => false, 'message' => 'Not authenticated']);
    ob_end_flush();
    exit();
}

$userId = $_SESSION['user_id'];

try {
    // Clear any previous output
    ob_clean();
    
    require_once 'config/db_connection.php';
    require_once 'web_push_notification.php';
    
    error_log("=== NEW ORDER SIMULATION STARTED ===");
    error_log("Simulating new order for user: $userId");

    // Simulate a new order with realistic data
    $testOrderId = 'TEST-' . time();
    $testCustomerName = 'Test Customer ' . rand(1000, 9999);
    $testAddress = '123 Test Street, Test City, Test State - ' . rand(100000, 999999);
    $testAmount = rand(100, 1000) . '.' . rand(10, 99);
    $testOrderType = rand(0, 1) ? 'delivery' : 'dining';

    error_log("Test Order Details:");
    error_log("- Order ID: $testOrderId");
    error_log("- Customer: $testCustomerName");
    error_log("- Address: $testAddress");
    error_log("- Amount: $testAmount");
    error_log("- Type: $testOrderType");

    // Send web push notification for simulated new order
    $result = WebPushNotification::sendNewOrderNotification(
        $userId,
        $testOrderId,
        $testCustomerName,
        $testAddress,
        $testAmount,
        $testOrderType
    );
    
    if ($result) {
        error_log("=== NEW ORDER SIMULATION SUCCESS ===");
        echo json_encode([
            'success' => true, 
            'message' => 'New order simulation successful! Check your device for push notification with ring sound.',
            'order_details' => [
                'order_id' => $testOrderId,
                'customer_name' => $testCustomerName,
                'address' => $testAddress,
                'amount' => '₹' . $testAmount,
                'type' => $testOrderType
            ]
        ]);
    } else {
        error_log("=== NEW ORDER SIMULATION FAILED ===");
        echo json_encode([
            'success' => false, 
            'message' => 'New order simulation failed. Check server logs for details.'
        ]);
    }
    
} catch (Exception $e) {
    error_log("=== NEW ORDER SIMULATION ERROR: " . $e->getMessage() . " ===");
    // Make sure to clear any partial output before sending JSON
    ob_clean();
    echo json_encode([
        'success' => false, 
        'message' => 'Error: ' . $e->getMessage()
    ]);
}

ob_end_flush();
?>